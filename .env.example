# ==============================================================================
# AgroBey - Variables d'Environnement de Production (.env.example)
# Copiez ce fichier vers .env et renseignez vos clés réelles
# ==============================================================================

# Environnement applicatif
NODE_ENV=production
APP_NAME=AgroBey
APP_URL=https://agrobey.sn
PORT=80
SSL_PORT=443

# Clé API Google Maps Platform (Optionnelle - Fallback Leaflet OpenStreetMap/Esri Satellite actif)
GOOGLE_MAPS_API_KEY=AIzaSy_VOTRE_CLE_GOOGLE_MAPS_PROD

# Serveur de Routage OSRM Dédié (Par défaut OSRM public ou instance privée)
OSRM_ROUTING_URL=https://router.project-osrm.org/route/v1/driving/

# Passerelles de Paiement Sénégal (Mobile Money)
WAVE_API_KEY=wave_live_xxxxxxxxxxxxxxxxxxxx
ORANGE_MONEY_MERCHANT_KEY=om_live_xxxxxxxxxxxx
FREE_MONEY_KEY=fm_live_xxxxxxxxxxxx

# Passerelle SMS / WhatsApp Notifications (Twilio ou Infobip)
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=221770000000
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Sécurité & Chiffrement
JWT_SECRET=agrobey_prod_super_secure_jwt_secret_2026_change_me!
SESSION_SECRET=agrobey_session_secret_xyz
CORS_ALLOWED_ORIGINS=https://agrobey.sn,https://admin.agrobey.sn,https://www.agrobey.sn
